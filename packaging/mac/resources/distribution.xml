<?xml version="1.0" encoding="utf-8"?>
<installer-gui-script minSpecVersion="2">
    <title>The Sauce Suite</title>
    <organization>com.drellmadeit</organization>
    <domains enable_localSystem="true"/>
    <options customize="allow" require-scripts="false" hostArchitectures="arm64,x86_64"/>
    <background file="background.png" alignment="bottomleft" scaling="none"/>
    <background-darkAqua file="background-darkAqua.png" alignment="bottomleft" scaling="none"/>
    <welcome file="welcome.html" mime-type="text/html"/>
    <license file="license.txt" mime-type="text/plain"/>
    <conclusion file="conclusion.html" mime-type="text/html"/>
    <choices-outline>
        <line choice="au"/>
        <line choice="vst3"/>
    </choices-outline>
    <choice id="au" title="Audio Unit (Logic Pro, GarageBand)" description="Installs The Sauce Suite.component to /Library/Audio/Plug-Ins/Components">
        <pkg-ref id="com.drellmadeit.thesaucesuite.au"/>
    </choice>
    <choice id="vst3" title="VST3 (FL Studio, Ableton Live, Studio One, Cubase, Reaper)" description="Installs The Sauce Suite.vst3 to /Library/Audio/Plug-Ins/VST3">
        <pkg-ref id="com.drellmadeit.thesaucesuite.vst3"/>
    </choice>
    <pkg-ref id="com.drellmadeit.thesaucesuite.au" version="__VERSION__">au.pkg</pkg-ref>
    <pkg-ref id="com.drellmadeit.thesaucesuite.vst3" version="__VERSION__">vst3.pkg</pkg-ref>
</installer-gui-script>

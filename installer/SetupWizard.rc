#include <winuser.h>
#include "resource.h"
1 RT_MANIFEST "Installer.manifest"
IDI_APP ICON "art/sauce.ico"
IDR_PLUGIN       RCDATA "payload/plugin.dll"
IDR_FONT_REGULAR RCDATA "../Resources/fonts/Poppins-Regular.ttf"
IDR_FONT_MEDIUM  RCDATA "../Resources/fonts/Poppins-Medium.ttf"
IDR_FONT_BOLD    RCDATA "../Resources/fonts/Poppins-Bold.ttf"
IDR_LOGO         RCDATA "art/wordmark.png"
IDR_LICENSE      RCDATA "text/license.txt"
IDR_PRESETS      RCDATA "payload/presets.txt"
IDR_WHATSNEW     RCDATA "payload/whatsnew.txt"
IDR_README       RCDATA "text/readme.txt"
1 VERSIONINFO
FILEVERSION 1,4,0,0
PRODUCTVERSION 1,4,0,0
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "040904b0"
    BEGIN
      VALUE "CompanyName", "Drellmadeit"
      VALUE "FileDescription", "The Sauce Suite Setup"
      VALUE "FileVersion", "1.4.0"
      VALUE "ProductName", "The Sauce Suite"
      VALUE "ProductVersion", "1.4.0"
      VALUE "LegalCopyright", "Copyright (c) 2026 Drellmadeit"
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x409, 1200
  END
END
